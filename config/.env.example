# ==============================================================
# config/.env.example — Pipeline Mobilité Durable
# Copier ce fichier en config/.env et adapter les valeurs
# ==============================================================

# Général
ENV=development
LOG_LEVEL=INFO
HEALTH_PORT=8080

# Base de données PostgreSQL
DATABASE_URL=postgresql+psycopg2://mobilite:secret@localhost:5432/mobilite_durable
# Ou bien renseigner les variables individuelles :
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mobilite_durable
# POSTGRES_USER=mobilite
# POSTGRES_PASSWORD=secret

# Sources CKAN — Lille (valeurs par défaut déjà dans settings.py)
# LILLE_CKAN_BASE_URL=https://data.lillemetropole.fr/api/3/action
# LILLE_DATASET_VELOS=disponibilite-des-velos-v-lille-metropole
# LILLE_DATASET_AIR=indice-atmo-nord-pas-de-calais
# LILLE_DATASET_TRAFIC=etat-du-trafic-en-temps-reel

# Sources CKAN — Montpellier (valeurs par défaut déjà dans settings.py)
# MONTPELLIER_CKAN_BASE_URL=https://data.montpellier3m.fr/api/3/action
# MONTPELLIER_DATASET_VELOS=tan-tan-disponibilite-temps-reel
# MONTPELLIER_DATASET_AIR=qualite-de-lair-sur-montpellier
# MONTPELLIER_DATASET_TRAFIC=etat-du-trafic-en-temps-reel-montpellier

# GTFS-RT (valeurs par défaut déjà dans settings.py)
# GTFSRT_ILEVIA_URL=https://proxy.transport.data.gouv.fr/resource/ilevia-lille-gtfs-rt
# GTFSRT_TAM_URL=https://data.montpellier3m.fr/api/explore/v2.1/catalog/datasets/tam-gtfsrt/exports/json
# GTFSRT_REFRESH_S=20

# HTTP Client
# HTTP_TIMEOUT_S=30
# HTTP_MAX_RETRIES=3
# HTTP_RETRY_WAIT_S=2.0

# Scheduler
# CKAN_REFRESH_S=60

# Power BI — Mode dev (Push URL directe, laisser vide si non utilisé)
POWERBI_PUSH_URL_LILLE=
POWERBI_PUSH_URL_MONTPELLIER=

# Power BI — Mode prod (OAuth2 Azure AD, laisser vide si non utilisé)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_DATASET_ID_LILLE=
POWERBI_DATASET_ID_MONTPELLIER=

# Rétention des données
# RETENTION_DAYS=90
